{"pageHead":"(title, desc, action) => `<div style=\"display: flex; align-items: flex-end; justify-content: space-between; gap: 24px;\">\n      <div>\n        <h1 style=\"margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 30px; line-height: 1.15; font-weight: 600; letter-spacing: -0.025em;\">${title}</h1>\n        <p style=\"margin: 6px 0 0; font-size: 16px; color: var(--fg2);\">${desc}</p>\n      </div>\n      ${action ? `<sc-if value=\"{{ isStaff }}\" hint-placeholder-val=\"{{ true }}\"><button style=\"height: 44px; padding: 0 18px; border: 0; border-radius: 10px; background: var(--brand); color: white; font: inherit; font-weight: 700; display: flex; align-items: center; gap: 8px; cursor: pointer; white-space: nowrap;\"><i class=\"icon-plus\" style=\"font-size: 18px;\"></i>${action}</button></sc-if>` : ''}\n    </div>`","viewsBar":"<div style=\"display: flex; align-items: center; gap: 6px; padding: 4px; background: var(--sunk); border-radius: 12px; align-self: flex-start;\">\n      <sc-for list=\"{{ views }}\" as=\"v\" hint-placeholder-count=\"5\">\n        <button onClick=\"{{ v.pick }}\" style=\"height: 38px; padding: 0 14px; border-radius: 9px; border: 0; background: {{ v.bg }}; color: {{ v.fg }}; font: inherit; font-weight: 700; display: flex; align-items: center; gap: 8px; cursor: pointer; box-shadow: {{ v.sh }}; white-space: nowrap;\">{{ v.label }}<span style=\"min-width: 22px; height: 22px; padding: 0 6px; box-sizing: border-box; border-radius: 99px; font-size: 12.5px; display: flex; align-items: center; justify-content: center; background: {{ v.cbg }}; color: {{ v.cfg }};\">{{ v.count }}</span></button>\n      </sc-for>\n    </div>","viewsJs":"const mkViews = (V, cur, set, alertKey) => V.map(([k, l, n]) => { const on = cur === k; return { label: l, count: n, pick: () => set(k), bg: on ? \"var(--surface)\" : \"transparent\", fg: on ? \"var(--fg)\" : \"var(--fg2)\", sh: on ? \"0 1px 2px var(--shc), 0 0 0 1px var(--line)\" : \"none\", cbg: k === alertKey ? \"var(--redSoft)\" : \"var(--line2)\", cfg: k === alertKey ? \"var(--red)\" : \"var(--fg2)\" }; });"}