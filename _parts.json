{"prefix":"<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;500;600;700&family=Atkinson+Hyperlegible:wght@400;700&family=Space+Grotesk:wght@500;600;700&display=swap\">\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lucide-static@0.469.0/font/lucide.css\">\n<style>body{margin:0}</style>\n</helmet>\n<div style=\"color-scheme: {{ scheme }};\">\n<div style=\"--bg: light-dark(oklch(0.982 0.003 260), oklch(0.15 0.008 260)); --surface: light-dark(oklch(1 0 0), oklch(0.19 0.009 260)); --sunk: light-dark(oklch(0.962 0.004 260), oklch(0.225 0.01 260)); --hover: light-dark(oklch(0.95 0.005 260), oklch(0.235 0.01 260)); --fg: light-dark(oklch(0.21 0.012 260), oklch(0.965 0.003 260)); --fg2: light-dark(oklch(0.44 0.012 260), oklch(0.78 0.008 260)); --fg3: light-dark(oklch(0.54 0.01 260), oklch(0.64 0.008 260)); --line: light-dark(oklch(0.905 0.005 260), oklch(0.275 0.01 260)); --line2: light-dark(oklch(0.935 0.004 260), oklch(0.235 0.009 260)); --side: light-dark(oklch(0.968 0.004 260), oklch(0.125 0.008 260)); --brand: light-dark(oklch(0.6 0.22 8.5), oklch(0.66 0.21 8.5)); --brandInk: light-dark(oklch(0.52 0.2 8.5), oklch(0.8 0.12 8.5)); --brandSoft: light-dark(oklch(0.955 0.03 8.5), oklch(0.27 0.07 8.5)); --red: light-dark(oklch(0.52 0.19 27), oklch(0.76 0.15 25)); --redSoft: light-dark(oklch(0.955 0.03 27), oklch(0.28 0.07 25)); --amber: light-dark(oklch(0.52 0.12 65), oklch(0.83 0.13 80)); --amberSoft: light-dark(oklch(0.96 0.045 85), oklch(0.29 0.06 75)); --green: light-dark(oklch(0.5 0.12 155), oklch(0.8 0.13 155)); --greenSoft: light-dark(oklch(0.955 0.035 155), oklch(0.27 0.05 155)); --blue: light-dark(oklch(0.5 0.13 250), oklch(0.8 0.1 245)); --blueSoft: light-dark(oklch(0.955 0.025 250), oklch(0.28 0.05 250)); --redBar: light-dark(oklch(0.62 0.2 27), oklch(0.68 0.18 25)); --amberBar: light-dark(oklch(0.75 0.15 75), oklch(0.78 0.14 78)); --greenBar: light-dark(oklch(0.64 0.14 155), oklch(0.68 0.14 155)); --blueBar: light-dark(oklch(0.6 0.13 250), oklch(0.68 0.12 248)); --shc: light-dark(oklch(0.25 0.02 260 / 0.07), oklch(0 0 0 / 0.35)); --solid: light-dark(oklch(0.21 0.012 260), oklch(0.96 0.003 260)); --onSolid: light-dark(oklch(0.99 0 0), oklch(0.17 0.01 260)); width: 1440px; min-height: 1500px; position: relative; display: flex; background: var(--bg); color: var(--fg); font-family: 'Atkinson Hyperlegible Next', 'Atkinson Hyperlegible', system-ui, sans-serif; font-size: 15px; line-height: 1.45; -webkit-font-smoothing: antialiased;\">\n\n<aside style=\"width: 248px; flex-shrink: 0; background: var(--side); border-right: 1px solid var(--line); display: flex; flex-direction: column; padding: 0 12px 12px; box-sizing: border-box;\">\n  <div style=\"height: 64px; display: flex; align-items: center; gap: 10px; padding: 0 6px;\">\n    <img src=\"assets/lootbloc-icon.png\" alt=\"Lootbloc\" style=\"width: 28px; height: 28px;\">\n    <span style=\"font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.01em;\">Lootbloc</span>\n    <span style=\"font-size: 13px; color: var(--fg3); font-weight: 600;\">Ops</span>\n  </div>\n  <button style=\"height: 42px; border: 0; border-radius: 10px; background: var(--brand); color: white; font: inherit; font-weight: 700; font-size: 15px; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; box-shadow: 0 1px 2px var(--shc); white-space: nowrap;\" style-hover=\"filter: brightness(1.06);\"><i class=\"icon-plus\" style=\"font-size: 18px;\"></i>Create new</button>\n  <nav style=\"flex: 1; display: flex; flex-direction: column; gap: 2px; margin-top: 16px;\">\n    <sc-for list=\"{{ nav }}\" as=\"g\" hint-placeholder-count=\"5\">\n      <div style=\"display: flex; flex-direction: column; gap: 2px; margin-bottom: 14px;\">\n        <sc-if value=\"{{ g.label }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg3); padding: 0 10px 6px;\">{{ g.label }}</div></sc-if>\n        <sc-for list=\"{{ g.items }}\" as=\"it\" hint-placeholder-count=\"3\">\n          <a href=\"{{ it.href }}\" style=\"text-decoration: none; height: 38px; display: flex; align-items: center; gap: 10px; padding: 0 10px; border-radius: 9px; background: {{ it.bg }}; color: {{ it.fg }}; font-weight: {{ it.fw }}; box-shadow: {{ it.sh }}; cursor: pointer;\" style-hover=\"background: var(--hover); color: var(--fg);\">\n            <i class=\"{{ it.icon }}\" style=\"font-size: 18px; color: {{ it.ic }};\"></i>\n            <span style=\"flex: 1;\">{{ it.label }}</span>\n            <sc-if value=\"{{ it.count }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"min-width: 22px; height: 22px; padding: 0 7px; box-sizing: border-box; border-radius: 99px; font-size: 12.5px; font-weight: 700; display: flex; align-items: center; justify-content: center; background: {{ it.cbg }}; color: {{ it.cfg }};\">{{ it.count }}</span></sc-if>\n          </a>\n        </sc-for>\n      </div>\n    </sc-for>\n  </nav>\n  <div style=\"display: flex; flex-direction: column; gap: 2px; border-top: 1px solid var(--line); padding-top: 10px;\">\n    <div style=\"height: 38px; display: flex; align-items: center; gap: 10px; padding: 0 10px; border-radius: 9px; color: var(--fg2); cursor: pointer;\" style-hover=\"background: var(--hover);\"><i class=\"icon-circle-help\" style=\"font-size: 18px;\"></i>How do I…?</div>\n    <div style=\"height: 38px; display: flex; align-items: center; gap: 10px; padding: 0 10px; border-radius: 9px; color: var(--fg2); cursor: pointer;\" style-hover=\"background: var(--hover);\"><i class=\"icon-settings\" style=\"font-size: 18px;\"></i>Settings</div>\n    <div style=\"display: flex; align-items: center; gap: 10px; padding: 8px 10px; margin-top: 4px;\">\n      <span style=\"width: 34px; height: 34px; border-radius: 99px; background: var(--brandSoft); color: var(--brandInk); font-weight: 700; display: flex; align-items: center; justify-content: center;\">{{ user.initial }}</span>\n      <span style=\"display: flex; flex-direction: column; line-height: 1.25; min-width: 0;\"><span style=\"font-weight: 700;\">{{ user.name }}</span><span style=\"font-size: 13px; color: var(--fg3);\">{{ user.role }}</span></span>\n    </div>\n  </div>\n</aside>\n\n<div style=\"flex: 1; min-width: 0; display: flex; flex-direction: column;\">\n  <header style=\"height: 64px; box-sizing: border-box; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 12px; padding: 0 32px;\">\n    <div style=\"width: 460px; height: 42px; box-sizing: border-box; border: 1px solid var(--line); background: var(--surface); border-radius: 10px; display: flex; align-items: center; gap: 10px; padding: 0 12px; color: var(--fg3); cursor: text;\">\n      <i class=\"icon-search\" style=\"font-size: 18px;\"></i><span style=\"flex: 1;\">Search products, POs, SKUs, partners…</span><span style=\"font-size: 12px; font-weight: 700; border: 1px solid var(--line); border-radius: 6px; padding: 1px 6px; color: var(--fg3);\">Ctrl K</span>\n    </div>\n    <div style=\"flex: 1;\"></div>\n    <sc-if value=\"{{ isStaff }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"height: 42px; box-sizing: border-box; border: 1px solid var(--line); background: var(--surface); border-radius: 10px; display: flex; align-items: center; gap: 8px; padding: 0 12px; font-weight: 600; cursor: pointer;\"><i class=\"icon-globe\" style=\"font-size: 16px; color: var(--fg3);\"></i><span style=\"color: var(--fg3); font-weight: 500; white-space: nowrap;\">Showing</span><span style=\"white-space: nowrap;\">All partners</span><i class=\"icon-chevron-down\" style=\"font-size: 16px; color: var(--fg3);\"></i></div>\n    </sc-if>\n    <button onClick=\"{{ toggleScheme }}\" title=\"Switch light / dark\" style=\"height: 42px; box-sizing: border-box; border: 1px solid var(--line); background: var(--surface); color: var(--fg2); border-radius: 10px; display: flex; align-items: center; gap: 8px; padding: 0 12px; font: inherit; font-weight: 600; cursor: pointer; white-space: nowrap;\" style-hover=\"color: var(--fg);\"><i class=\"{{ schemeIcon }}\" style=\"font-size: 17px;\"></i>{{ schemeLabel }}</button>\n    <div style=\"position: relative; width: 42px; height: 42px; box-sizing: border-box; border: 1px solid var(--line); background: var(--surface); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--fg2);\"><i class=\"icon-bell\" style=\"font-size: 18px;\"></i><span style=\"position: absolute; top: -5px; right: -5px; min-width: 20px; height: 20px; border-radius: 99px; background: var(--brand); color: white; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; border: 2px solid var(--bg);\">7</span></div>\n  </header>\n\n  ","navCode":"  nav(role) {\n    const page = this.pageName ? this.pageName() : \"Home\";\n    const it = (icon, label, href, o = {}) => ({ icon: \"icon-\" + icon, label, href, ...o, active: label === page });\n    const staff = [\n      { label: \"\", items: [it(\"house\", \"Home\", \"Home Custom.dc.html\")] },\n      { label: \"My work\", items: [it(\"list-checks\", \"Tasks\", \"#\", { count: 4 }), it(\"square-check-big\", \"Approvals\", \"Approvals.dc.html\", { count: 3, alert: true }), it(\"calendar-days\", \"Calendar\", \"#\"), it(\"chart-gantt\", \"Timeline\", \"#\")] },\n      { label: \"Make & sell\", items: [it(\"layers\", \"Products\", \"Products.dc.html\"), it(\"package\", \"Purchase orders\", \"Purchase Orders.dc.html\"), it(\"factory\", \"Vendors & factories\", \"#\")] },\n      { label: \"Stock & shipping\", items: [it(\"warehouse\", \"Inventory\", \"Inventory.dc.html\", { count: 3, alert: true }), it(\"truck\", \"Shipments\", \"Shipments.dc.html\", { count: 1, alert: true })] },\n      { label: \"Money\", items: [it(\"receipt\", \"Invoices\", \"Invoices.dc.html\", { count: 1, alert: true }), it(\"hand-coins\", \"Payouts\", \"#\", { count: \"Soon\" }), it(\"refresh-cw\", \"QuickBooks\", \"#\")] },\n      { label: \"Company\", items: [it(\"building-2\", \"Partners\", \"#\"), it(\"library\", \"Resources\", \"#\"), it(\"chevrons-right\", \"More tools\", \"#\")] },\n    ];\n    const partner = [\n      { label: \"\", items: [it(\"house\", \"Home\", \"Home Custom.dc.html\")] },\n      { label: \"Your products\", items: [it(\"square-check-big\", \"Approvals\", \"Approvals.dc.html\", { count: 2, alert: true }), it(\"layers\", \"Products\", \"Products.dc.html\"), it(\"warehouse\", \"Inventory\", \"Inventory.dc.html\"), it(\"package\", \"Purchase orders\", \"Purchase Orders.dc.html\"), it(\"truck\", \"Shipments\", \"Shipments.dc.html\")] },\n    ];\n    return (role === \"partner\" ? partner : staff).map(g => ({ ...g, items: g.items.map(i => ({ ...i,\n      bg: i.active ? \"var(--surface)\" : \"transparent\", fg: i.active ? \"var(--fg)\" : \"var(--fg2)\", fw: i.active ? 700 : 500,\n      sh: i.active ? \"0 1px 2px var(--shc), 0 0 0 1px var(--line)\" : \"none\", ic: i.active ? \"var(--brandInk)\" : \"var(--fg3)\",\n      cbg: i.alert ? \"var(--redSoft)\" : \"var(--sunk)\", cfg: i.alert ? \"var(--red)\" : \"var(--fg2)\" })) }));\n  }\n","common":"\n  base() {\n    const role = this.props.role ?? \"ops\";\n    const scheme = this.state.scheme ?? this.props.scheme ?? \"dark\";\n    return { role, scheme, schemeIcon: scheme === \"dark\" ? \"icon-sun\" : \"icon-moon\", schemeLabel: scheme === \"dark\" ? \"Light\" : \"Dark\",\n      toggleScheme: () => this.setState({ scheme: scheme === \"dark\" ? \"light\" : \"dark\" }), isStaff: role !== \"partner\", nav: this.nav(role),\n      user: { ops: { name: \"Jordan\", initial: \"J\", role: \"Ops Staff\" }, finance: { name: \"Priya\", initial: \"P\", role: \"Lootbloc Staff · Finance\" }, partner: { name: \"Twin Atlas\", initial: \"T\", role: \"Partner Admin\" } }[role] };\n  }\n  tones() {\n    return { red: { ink: \"var(--red)\", soft: \"var(--redSoft)\", bar: \"var(--redBar)\" }, amber: { ink: \"var(--amber)\", soft: \"var(--amberSoft)\", bar: \"var(--amberBar)\" },\n      green: { ink: \"var(--green)\", soft: \"var(--greenSoft)\", bar: \"var(--greenBar)\" }, blue: { ink: \"var(--blue)\", soft: \"var(--blueSoft)\", bar: \"var(--blueBar)\" },\n      brand: { ink: \"var(--brandInk)\", soft: \"var(--brandSoft)\", bar: \"var(--brand)\" }, none: { ink: \"var(--fg2)\", soft: \"var(--sunk)\", bar: \"var(--fg3)\" }, neutral: { ink: \"var(--fg2)\", soft: \"var(--sunk)\", bar: \"var(--fg3)\" } };\n  }\n  load() { import(new URL(\"pagesData.js\", document.baseURI).href).then(P => this.setState({ P })); }\n","scriptOpen":"<script type=\"text/x-dc\" data-dc-script data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1440,&quot;height&quot;:1200},&quot;scheme&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;dark&quot;,&quot;light&quot;],&quot;default&quot;:&quot;dark&quot;,&quot;tsType&quot;:&quot;'dark'|'light'&quot;},&quot;role&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;ops&quot;,&quot;finance&quot;,&quot;partner&quot;],&quot;default&quot;:&quot;ops&quot;,&quot;tsType&quot;:&quot;'ops'|'finance'|'partner'&quot;}}\">"}